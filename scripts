@contextmanager
def Dataset(source):
    # netCDF's Windows HDF4 reader needs an ASCII path. Use the filesystem's
    # short path when available, otherwise copy into a temporary directory.
    path = Path(source)
    if os.name == 'nt' and not str(path).isascii():
        import ctypes
        buffer = ctypes.create_unicode_buffer(32768)
        length = ctypes.windll.kernel32.GetShortPathNameW(str(path.resolve()), buffer, len(buffer))
        if length and buffer.value.isascii():
            path = Path(buffer.value)
        else:
            with tempfile.TemporaryDirectory(prefix='terra-') as temporary:
                target = Path(temporary) / 'observation.nc'
                shutil.copyfile(path, target)
                with NetCDFDataset(target) as dataset:
                    yield dataset
            return
    with NetCDFDataset(path) as dataset:
        yield dataset


