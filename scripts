def aerosol_values(source, variable):
    field, label, units, low, high = AEROSOL_FIELDS[variable]
    with Dataset(source) as dataset:
        latitude = masked_float(dataset.variables['Latitude'])
        longitude = masked_float(dataset.variables['Longitude'])
        values = masked_float(dataset.variables[field])
    return latitude, longitude, values, label, units, low, high


def aerosol_result(args):
    latitude, longitude, values, label, units, low, high = aerosol_values(args.source, args.variable)
    result = {'layer': 'aerosol', 'variable': args.variable, 'label': label, 'units': units,
              'coverage': 'single satellite swath; not global coverage', 'quality': 'product Best_Estimate QA-filtered field'}
    if args.sample_lat is not None:
        # Great-circle distance prevents a remote swath edge being reported as a local observation.
        lat1, lat2 = np.deg2rad(args.sample_lat), np.deg2rad(latitude)
        dlon = np.deg2rad(longitude - args.sample_lon)
        hav = np.sin((lat2 - lat1) / 2) ** 2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon / 2) ** 2
        distance = 6371.0 * 2 * np.arcsin(np.sqrt(np.clip(hav, 0, 1)))
        distance[~np.isfinite(latitude) | ~np.isfinite(longitude)] = np.inf
        row, col = np.unravel_index(np.argmin(distance), distance.shape)
        covered = bool(distance[row, col] <= 25)
        value = values[row, col]
        return {**result, 'value': float(value) if covered and np.isfinite(value) else None,
                'masked': not covered or not bool(np.isfinite(value)), 'withinCoverage': covered,
                'latitude': float(latitude[row, col]), 'longitude': float(longitude[row, col]),
                'sampleMethod': 'nearest swath cell within 25 km'}
    return {**result, **colorize(regrid(latitude, longitude, values), args.output, low, high)}
